# Mapbox Public Access Token (used on frontend to display maps and fetch routes)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_access_token_here

# Mapbox Secret Download Token (required in gradle/podfile/npm config to download Mapbox SDK - DO NOT share or commit this!)
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN=your_mapbox_secret_download_token_here
